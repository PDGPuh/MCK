{
  "name": "mck-hvl-player",
  "private": true,
  "version": "1.0.0",
  "description": "MCK HVL Music Player Desktop Application",
  "author": "HVL Player",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "tsc && vite build && electron-builder"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.428.0",
    "motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.mck.hvlplayer",
    "productName": "MCK HVL Player",
    "executableName": "MCKHVLPlayer",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "public/audio",
        "to": "public/audio"
      }
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
